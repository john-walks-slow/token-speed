{
  "prompt": "Hello, tell me a short story in 3 sentences.",
  "max_tokens": 256,
  "temperature": null,
  "stream": true,
  "concurrency": 1,
  "iterations": 1,
  "max_rpm": 20,
  "timeout": 120,
  "targets": [
    {
      "provider_name": "Groq",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "GROQ_API_KEY",
      "protocol": "openai",
      "models": [
        "openai/gpt-oss-20b",
        "openai/gpt-oss-120b",
        "openai/gpt-oss-safeguard-20b",
        "qwen/qwen3.8-27b",
        "allam-2-7b",
        "groq/compound",
        "groq/compound-mini"
      ]
    },
    {
      "provider_name": "NVIDIA NIM",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "api_key_env": "NVIDIA_API_KEY",
      "protocol": "openai",
      "discover": true,
      "models": [
        "openai/gpt-oss-20b",
        "nvidia/nemotron-3.5-lightning-30b-a3b"
      ],
      "blacklist": [
        ".*(embed|retriever|clip|parse|reward|guard|safety).*",
        "nvidia/ai-synthetic-video-detector",
        "nvidia/riva-translate-.*",
        "nvidia/cosmos-reason2-8b",
        "nvidia/vila",
        "nvidia/neva-22b",
        "nvidia/ising-calibration-1.5-31b",
        "google/deplot",
        "google/gemma-2b",
        "microsoft/kosmos-2",
        "microsoft/phi-3-vision-128k-instruct",
        "meta/llama-3.2-11b-vision-instruct",
        "meta/llama-3.2-90b-vision-instruct",
        "adept/fuyu-8b",
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
        "nvidia/nemotron-3-super-120b-a12b",
        "meta/muse-glimmer-30b"
      ]
    },
    {
      "provider_name": "Google Gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "api_key_env": "GEMINI_API_KEY",
      "protocol": "openai",
      "models": [
        "gemini-3.8-flash",
        "gemini-3.7-flash",
        "gemini-3.6-flash",
        "gemini-3.5-flash",
        "gemini-3.5-flash-lite",
        "gemini-3.1-flash-lite",
        "gemini-flash-latest",
        "gemini-flash-lite-latest",
        "gemini-3.1-pro-preview",
        "gemini-pro-latest",
        "gemma-4-31b-it",
        "gemma-4-26b-a4b-it"
      ]
    },
    {
      "provider_name": "Cloudflare Workers AI",
      "base_url": "https://api.cloudflare.com/client/v4/accounts/5b393025ed97484019c46b8136af3aa5/ai/v1",
      "api_key_env": "CLOUDFLARE_API_KEY",
      "protocol": "openai",
      "discover": true,
      "discover_url": "https://api.cloudflare.com/client/v4/accounts/5b393025ed97484019c46b8136af3aa5/ai/models/search?task=Text%20Generation&per_page=100",
      "models": [],
      "whitelist": ["@cf/.*"],
      "blacklist": [
        ".*(vision|guard|lora).*|@cf/meta-llama/.*"
      ]
    },
    {
      "provider_name": "OpenRouter",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "protocol": "openai",
      "discover": true,
      "models": [],
      "whitelist": [".*:free"],
      "blacklist": [
        ".*inkling.*",
        "nvidia/nemotron-3.5-content-safety:free"
      ]
    },
    {
      "provider_name": "ModelScope",
      "base_url": "https://api-inference.modelscope.cn/v1",
