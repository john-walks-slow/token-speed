      "discover_url": "https://api.kilo.ai/api/gateway/models",
      "models": [],
      "whitelist": [".*:free"],
      "blacklist": [
        ".*inkling.*",
        "nvidia/nemotron-3.5-content-safety:free"
      ]
    }
  ]
}
